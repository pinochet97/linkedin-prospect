# ---------------------------------------------------------------------------
# Banco de dados (Supabase ou Postgres local)
# Supabase: Project Settings -> Database -> Connection string -> URI
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/linkedin_prospect

# ---------------------------------------------------------------------------
# Autenticação (admin único, uso interno)
# APP_SECRET assina o cookie de sessão. Gere com: openssl rand -hex 32
# ---------------------------------------------------------------------------
APP_SECRET=troque-isto-por-uma-string-aleatoria-de-32-chars
ADMIN_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------------------
# OpenAI. Sem chave o sistema usa o gerador determinístico (AI_MODE=mock).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MODE=auto

# ---------------------------------------------------------------------------
# Automação
# LINKEDIN_ADAPTER=mock  -> nenhum browser é aberto (desenvolvimento/testes)
# LINKEDIN_ADAPTER=real  -> Playwright + Chromium com perfil persistente
# DRY_RUN=true           -> navega, gera mensagens, encontra os botões, mas
#                           NUNCA clica no envio final. Padrão seguro.
# ---------------------------------------------------------------------------
LINKEDIN_ADAPTER=mock
DRY_RUN=true
HEADLESS=false
CHROME_PROFILE_DIR=.data/chrome-profile
SCREENSHOT_DIR=.data/screenshots

# ---------------------------------------------------------------------------
# Feature flags (permitem testar o sistema parte por parte)
# ---------------------------------------------------------------------------
ENABLE_DISCOVERY=true
ENABLE_CONNECTIONS=true
ENABLE_MESSAGES=true
ENABLE_FOLLOWUPS=true
ENABLE_REPLY_CHECK=true

# ---------------------------------------------------------------------------
# Worker / ritmo
# ---------------------------------------------------------------------------
WORKER_TICK_SECONDS=60
ACTIONS_PER_HOUR=20
MIN_ACTION_DELAY_MS=4000
MAX_ACTION_DELAY_MS=12000
CONNECTION_CHECK_INTERVAL_HOURS=6
CONNECTION_EXPIRE_DAYS=30
APP_TIMEZONE=America/Sao_Paulo
